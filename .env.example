# Django core
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SSL_REDIRECT=1

# Optional: PostgreSQL cache for public vulnerability/news data only
# (Leave POSTGRES_DB unset to use in-memory cache locally.)
POSTGRES_DB=
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# External API keys (optional; improves NVD rate limits)
NVD_API_KEY=

# Security & rate limiting
SENTINEL_RATE_LIMIT=10
SENTINEL_PREVIEW_RATE_LIMIT=30
SENTINEL_TRUST_PROXY=0
