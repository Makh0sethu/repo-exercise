# /etc/sentinel/env on the server (root:sentinel, 600). install.sh creates it from this file on the
# first run and fills in the secrets marked "generated". Edit later with: sudoedit /etc/sentinel/env
# Never commit the real file or paste its values into chat.

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generated
DJANGO_ALLOWED_HOSTS=uhambo.co.zw,www.uhambo.co.zw,sentinel.uhambo.co.zw,127.0.0.1
DJANGO_SSL_REDIRECT=1

# Where the site lives. Today: a path on the main site (no DNS needed), uhambo.co.zw/sentinel/.
# To move to sentinel.uhambo.co.zw: add the DNS record, empty SENTINEL_URL_PREFIX, set SENTINEL_BASE_URL
# to https://sentinel.uhambo.co.zw, then re-run the release. install.sh switches nginx over.
SENTINEL_URL_PREFIX=/sentinel

# Public test site: scanner, results, news and About only. Admin, sign-in and Security runs are not routed.
SENTINEL_PUBLIC_ONLY=1
SENTINEL_OPEN_ACCESS=0
SENTINEL_ADMIN_PATH=generated
SENTINEL_BASE_URL=https://uhambo.co.zw/sentinel

# Behind nginx + Cloudflare. nginx overwrites X-Forwarded-For with the real visitor IP.
SENTINEL_TRUST_X_FORWARDED_FOR=1
SENTINEL_HTTPS=1

# The code in /opt/sentinel is read-only for the app; everything it writes lives here.
SENTINEL_SQLITE_PATH=/var/lib/sentinel/db.sqlite3
SENTINEL_CACHE_PATH=/var/lib/sentinel/cache/public-cache.sqlite3
SENTINEL_LOG_DIR=/var/lib/sentinel/logs
SENTINEL_EVIDENCE_DIR=/var/lib/sentinel/evidence
SENTINEL_OSV_DIR=/var/lib/sentinel/osv-data

# Scan logs (time, IP, package list) are deleted after this many days by sentinel-maintenance.timer.
SENTINEL_LOG_RETENTION_DAYS=30
SENTINEL_RATE_LIMIT=10
SENTINEL_PREVIEW_RATE_LIMIT=30
SENTINEL_SCAN_DEADLINE=25

# Optional: raises NVD from 5 to 50 requests per 30 s.
NVD_API_KEY=
